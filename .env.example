# ─── Server ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/oud_alnood
# For MongoDB Atlas (recommended):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/oud_alnood?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Frontend CORS ────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── File Uploads ─────────────────────────
MAX_FILE_SIZE=5242880

# ─── Cloudinary ───────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── PayPal ───────────────────────────────
# sandbox | live  (sandbox credentials only work with sandbox, live with live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Webhook ID from the PayPal dashboard (URL: https://api.oudalanood.com/api/payments/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Store prices are in MYR. MYR only works for Malaysian PayPal business accounts;
# otherwise charge another currency and set the MYR -> currency rate.
PAYPAL_CURRENCY=MYR
PAYPAL_EXCHANGE_RATE=1
